{
  "name": "LegalRequirements",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "requirement_type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "appointment_date": {
      "type": "string",
      "format": "date"
    },
    "location": {
      "type": "string"
    },
    "officer_or_contact_name": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "reminder_enabled": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "completed",
        "missed"
      ],
      "default": "active"
    }
  },
  "required": [
    "title"
  ]
}