{
  "name": "AhHaInspirationStory",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "story": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Help",
        "Hope",
        "Healing"
      ],
      "default": "Hope"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "recovery_stage": {
      "type": "string",
      "enum": [
        "early_recovery",
        "long_term_recovery",
        "reentry",
        "family_support",
        "mental_health",
        "general"
      ],
      "default": "general"
    },
    "moderation_status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "approved",
        "rejected",
        "hidden"
      ],
      "default": "pending_review"
    },
    "privacy": {
      "type": "string",
      "enum": [
        "anonymous",
        "first_name_only",
        "public_profile",
        "private"
      ],
      "default": "anonymous"
    },
    "is_positive_content": {
      "type": "boolean",
      "default": true
    },
    "helpful_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "story"
  ]
}