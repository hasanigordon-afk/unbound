{
  "name": "MyPathRoutine",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "meeting",
        "work",
        "gym",
        "personal",
        "health",
        "family",
        "spiritual",
        "other"
      ],
      "default": "personal"
    },
    "days_of_week": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "0=Sun, 1=Mon \u2026 6=Sat"
    },
    "time_of_day": {
      "type": "string",
      "enum": [
        "morning",
        "afternoon",
        "evening",
        "anytime"
      ],
      "default": "anytime"
    },
    "color": {
      "type": "string",
      "default": "#2DD4BF"
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_email",
    "title",
    "category"
  ]
}