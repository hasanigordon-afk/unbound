{
  "name": "PushNotification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "subscription_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "check_in",
        "meeting",
        "task",
        "transportation",
        "support_circle",
        "risk_alert",
        "ai_recommendation",
        "campaign"
      ]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "sent",
        "failed",
        "read"
      ],
      "default": "scheduled"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    },
    "target_route": {
      "type": "string"
    },
    "campaign_id": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "title",
    "body"
  ]
}
