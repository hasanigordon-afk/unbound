{
  "name": "SuperAgentPlan",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "plan_title": {
      "type": "string"
    },
    "plan_type": {
      "type": "string",
      "enum": [
        "daily",
        "7_day",
        "30_day",
        "90_day"
      ],
      "default": "7_day"
    },
    "plan_summary": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "description": "Optional category tag matching SuperAgentConversation categories"
    },
    "action_steps": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "completed": {
            "type": "boolean",
            "default": false
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "priority_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "source_conversation_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "archived"
      ],
      "default": "active"
    },
    "started_at": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "user_email",
    "plan_title",
    "plan_type"
  ]
}