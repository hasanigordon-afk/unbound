{
  "name": "RecoveryPathTask",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "recovery",
        "wellness",
        "responsibilities",
        "family",
        "health",
        "employment",
        "legal_probation",
        "personal_growth"
      ]
    },
    "days_of_week": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "0=Sun 6=Sat"
    },
    "preferred_time": {
      "type": "string"
    },
    "recurrence": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "custom"
      ],
      "default": "weekly"
    },
    "priority": {
      "type": "string",
      "enum": [
        "essential",
        "high",
        "normal",
        "optional"
      ],
      "default": "normal"
    },
    "estimated_minutes": {
      "type": "number",
      "default": 30
    },
    "notes": {
      "type": "string"
    },
    "is_essential": {
      "type": "boolean",
      "default": false
    },
    "journey_mode": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_email",
    "title",
    "category"
  ]
}