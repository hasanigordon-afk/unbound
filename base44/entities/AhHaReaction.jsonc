    },
    "user_email": {
      "type": "string"
    },
    "reaction_type": {
      "type": "string",
      "enum": [
        "felt_this",
        "gave_me_strength",
        "not_alone",
        "bookmark"
      ],
      "default": "felt_this"
    }
