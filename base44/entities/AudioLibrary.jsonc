{
  "name": "AudioLibrary",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number"
    },
    "category": {
      "type": "string",
      "enum": [
        "breathing",
        "meditation",
        "binaural_beats",
        "na_aa_audio",
        "music",
        "grounding",
        "motivation"
      ]
    },
    "transcript": {
      "type": "string"
    },
    "playlist_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "recovery_stage": {
      "type": "string"
    },
    "moderation_status": {
      "type": "string",
      "enum": [
        "pending_review",
        "approved",
        "rejected",
        "hidden"
      ],
      "default": "approved"
    }
  },
  "required": [
    "title",
    "audio_url",
    "category"
  ]
}
