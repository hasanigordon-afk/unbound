{
  "name": "Reminders",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "appointment_id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "reminder_date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "repeat": {
      "type": "string",
      "enum": [
        "none",
        "daily",
        "weekly",
        "monthly"
      ],
      "default": "none"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "dismissed"
      ],
      "default": "active"
    }
  },
  "required": [
    "title"
  ]
}