{
  "name": "Reminders",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "appointment_id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "reminder_title": {
      "type": "string"
    },
    "reminder_type": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "reminder_date": {
      "type": "string",
      "format": "date"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "scheduled_time": {
      "type": "string"
    },
    "repeat": {
      "type": "string",
      "enum": [
        "none",
        "daily",
        "weekly",
        "monthly"
      ],
      "default": "none"
    },
    "recurrence": {
      "type": "string"
    },
    "delivery_method": {
      "type": "string",
      "enum": [
        "in_app",
        "email",
        "sms"
      ],
      "default": "in_app"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "dismissed"
      ],
      "default": "active"
    }
  },
  "required": [
    "title"
  ]
}