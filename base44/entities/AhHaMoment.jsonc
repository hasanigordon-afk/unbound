{
  "name": "AhHaMoment",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false
    },
    "category": {
      "type": "string",
      "enum": [
        "wake_up_call",
        "rock_bottom",
        "my_child_saved_me",
        "health_scare",
        "jail_court",
        "tired_of_running",
        "wanted_my_life_back",
        "no_more_excuses"
      ]
    },
    "what_happened": {
      "type": "string"
    },
    "feeling_in_moment": {
      "type": "string"
    },
    "tired_of_repeating": {
      "type": "string"
    },
    "decision_made": {
      "type": "string"
    },
    "message_to_others": {
      "type": "string"
    },
    "content_warning": {
      "type": "string"
    },
    "has_content_warning": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "private",
        "pending_review",
        "pending",
        "approved",
        "flagged",
        "rejected"
      ],
      "default": "draft"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "reaction_count": {
      "type": "number",
      "default": 0
    },
    "comment_count": {
      "type": "number",
      "default": 0
    },
    "save_count": {
      "type": "number",
      "default": 0
    },
    "moderation_note": {
      "type": "string"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "video",
        "audio",
        "text"
      ],
      "default": "text",
      "description": "Type of recording or text-only story"
    },
    "media_url": {
      "type": "string",
      "description": "URL of the uploaded video/audio file"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Thumbnail URL for video recordings"
    },
    "duration": {
      "type": "number",
      "description": "Duration of media in seconds"
    },
    "is_private": {
      "type": "boolean",
      "default": true,
      "description": "Whether the moment is kept private"
    },
    "is_submitted": {
      "type": "boolean",
      "default": false,
      "description": "Whether submitted for community review"
    },
    "is_approved": {
      "type": "boolean",
      "default": false,
      "description": "Whether approved by admin"
    },
    "allow_comments": {
      "type": "boolean",
      "default": true
    },
    "anonymous_post": {
      "type": "boolean",
      "default": false,
      "description": "Display anonymously in community feed"
    },
    "consent_given": {
      "type": "boolean",
      "default": false,
      "description": "User consented to public sharing"
    },
    "admin_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Admin-assigned tags like Featured, High Impact, New"
    },
    "question_responses": {
      "type": "array",
      "description": "Per-question media recordings",
      "items": {
        "type": "object",
        "properties": {
          "question_index": {
            "type": "number"
          },
          "media_url": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "user_email"
  ]
}