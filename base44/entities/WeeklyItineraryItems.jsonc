{
  "name": "WeeklyItineraryItems",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "day": {
      "type": "string"
    },
    "time": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "transportation_needed": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "completed",
        "cancelled"
      ],
      "default": "active"
    }
  },
  "required": [
    "title"
  ]
}
