{
  "name": "HomeModuleActivity",
  "type": "object",
  "properties": {
    "module_key": {
      "type": "string"
    },
    "section_title": {
      "type": "string"
    },
    "module_title": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "opened",
        "pinned",
        "unpinned",
        "started",
        "completed",
        "saved"
      ],
      "default": "opened"
    },
    "created_at_text": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "module_key",
    "module_title",
    "user_email",
    "action_type"
  ]
}