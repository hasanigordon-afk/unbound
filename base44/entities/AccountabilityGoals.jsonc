{
  "name": "AccountabilityGoals",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "needs_review": {
      "type": "boolean",
      "default": false
    },
    "confirmed": {
      "type": "boolean",
