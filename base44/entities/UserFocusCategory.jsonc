{
  "name": "UserFocusCategory",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "category_name": {
      "type": "string"
    },
    "category_key": {
      "type": "string",
      "enum": [
        "recovery",
        "productivity",
        "physical_health",
        "relationships",
        "mental_growth"
      ]
    },
    "icon": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_email",
    "category_name",
    "category_key"
  ]
}