{
  "name": "AhHaStoryTag",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name e.g. Recovery"
    },
    "slug": {
      "type": "string",
      "description": "URL-safe unique key e.g. recovery"
    },
    "description": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "slug"
  ]
}