{
  "name": "SupportContact",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Owner email"
    },
    "name": {
      "type": "string",
      "description": "Contact or helpline name"
    },
    "relationship": {
      "type": "string",
      "enum": [
        "sponsor",
        "family",
        "friend",
        "counselor",
        "peer",
        "helpline",
        "other"
      ],
      "description": "Relationship or contact type"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "preferred_channel": {
      "type": "string",
      "enum": [
        "call",
        "text",
        "email"
      ],
      "default": "call",
      "description": "Preferred contact channel"
    },
    "contact_type": {
      "type": "string",
      "enum": [
        "personal_contact",
        "local_helpline",
        "crisis_helpline"
      ],
      "default": "personal_contact",
      "description": "Emergency support contact category"
    },
    "location": {
      "type": "string",
      "description": "City, county, or area served"
    },
    "notes": {
      "type": "string",
      "description": "Helpful notes for when to call this contact"
    },
    "is_primary": {
      "type": "boolean",
      "default": false,
      "description": "Primary emergency contact"
    }
  },
  "required": [
    "name"
  ]
}