{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "member_user_id": {
      "type": "string",
      "description": "Member user ID"
    },
    "mentor_user_id": {
      "type": "string",
      "description": "Mentor user ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "closed"
      ],
      "default": "pending",
      "description": "Conversation status"
    }
  },
  "required": [
    "member_user_id",
    "mentor_user_id"
  ]
}