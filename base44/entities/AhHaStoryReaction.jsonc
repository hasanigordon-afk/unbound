{
  "name": "AhHaStoryReaction",
  "type": "object",
  "properties": {
    "story_id": {
      "type": "string"
    },
    "reaction_type": {
      "type": "string",
      "enum": [
        "Inspired",
        "Respect",
        "Powerful",
        "Needed This",
        "Proud Of You"
      ],
      "default": "Inspired"
    },
    "user_email": {
      "type": "string"
    }
  },
  "required": [
    "story_id",
    "reaction_type"
  ]
}