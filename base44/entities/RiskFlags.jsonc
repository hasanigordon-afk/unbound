{
  "name": "RiskFlags",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "risk_type": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "Low",
        "Moderate",
        "High",
        "Urgent"
      ],
      "default": "Moderate"
    },
    "description": {
      "type": "string"
    },
    "suggested_action": {
      "type": "string"
    },
    "counselor_reviewed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "risk_type",
    "description"
  ]
}