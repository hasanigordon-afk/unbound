{
  "name": "LearnRecoveryContent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "understanding",
        "tips",
        "motivation",
        "brain",
        "relationships",
        "myths"
      ],
      "default": "tips"
    },
    "read_time_mins": {
      "type": "number",
      "default": 1
    },
    "emoji": {
      "type": "string"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "body",
    "category"
  ]
}