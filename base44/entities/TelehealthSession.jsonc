{
  "name": "TelehealthSession",
  "type": "object",
  "properties": {
    "participant_email": {
      "type": "string",
      "description": "Primary participant email (for 1:1 sessions)"
    },
    "group_participant_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "All participant emails (used for group events)"
    },
    "is_group_event": {
      "type": "boolean",
      "default": false,
      "description": "True if this is a group session"
    },
    "provider_email": {
      "type": "string",
      "description": "Counselor or provider email"
    },
    "provider_name": {
      "type": "string",
      "description": "Provider display name"
    },
    "session_type": {
      "type": "string",
      "enum": [
        "individual_counseling",
        "group_meeting",
        "discharge_planning",
        "sponsor_call",
        "peer_support",
        "medication_check"
      ],
      "description": "Type of session"
    },
    "title": {
      "type": "string",
      "description": "Session title (especially for group events)"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "in_progress",
        "completed",
        "cancelled",
        "no_show"
      ],
      "default": "scheduled"
    },
    "attendance_status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "reschedule_requested"
      ],
      "default": "pending",
      "description": "Patient's attendance confirmation status"
    },
    "reschedule_note": {
      "type": "string",
      "description": "Note from patient when requesting a reschedule"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "scheduled_time": {
      "type": "string",
      "description": "HH:MM format"
    },
    "duration_minutes": {
      "type": "number",
      "default": 50
    },
    "meeting_url": {
      "type": "string",
      "description": "Video/audio session link"
    },
    "notes": {
      "type": "string",
      "description": "Pre-session notes visible to patient"
    },
    "session_notes": {
      "type": "string",
      "description": "Post-session counselor notes (private)"
    },
    "facility_id": {
      "type": "string"
    }
  },
  "required": [
    "session_type",
    "scheduled_date",
    "scheduled_time"
  ]
}