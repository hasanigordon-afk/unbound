{
  "name": "Milestones",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "achieved_at": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "support_circle",
        "public"
      ],
      "default": "private"
    },
    "badge_icon": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "title"
  ]
}
