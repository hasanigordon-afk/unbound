{
  "name": "ResetProgram",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date",
      "description": "Day 1 of the program (YYYY-MM-DD)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "completed",
        "abandoned"
      ],
      "default": "active"
    },
    "fasting_enabled": {
      "type": "boolean",
      "default": false
    },
    "completed_at": {
      "type": "string",
      "format": "date"
    },
    "last_reflection": {
      "type": "string",
      "description": "Optional free-text from latest daily reflection"
    }
  },
  "required": [
    "user_email",
    "started_at"
  ]
}