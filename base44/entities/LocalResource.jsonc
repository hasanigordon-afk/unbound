{
  "name": "LocalResource",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "hours_text": {
      "type": "string"
    },
    "hours": {
      "type": "object"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "transportation_available": {
      "type": "boolean",
      "default": false
    },
    "medicaid_accepted": {
      "type": "boolean",
      "default": false
    },
    "veterans": {
      "type": "boolean",
      "default": false
    },
    "free_services": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "category",
    "address"
  ]
}