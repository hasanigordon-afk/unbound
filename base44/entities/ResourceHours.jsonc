{
  "name": "ResourceHours",
  "type": "object",
  "properties": {
    "resource_id": {
      "type": "string"
    },
    "day_of_week": {
      "type": "string",
      "enum": [
        "sun",
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat"
      ]
    },
    "open_time": {
      "type": "string"
    },
    "close_time": {
      "type": "string"
    },
    "closed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "resource_id",
    "day_of_week"
  ]
}