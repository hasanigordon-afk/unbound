{
  "name": "CommunityGroup",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "category": {
      "type": "string",
      "enum": ["early_recovery", "reentry", "veterans", "employment", "wellness", "parenting", "sober_living", "mental_health", "general"],
      "default": "general"
    },
    "privacy": {
      "type": "string",
      "enum": ["public", "private", "facility_only"],
      "default": "public"
    }
  },
  "required": ["name", "category", "privacy"]
}
