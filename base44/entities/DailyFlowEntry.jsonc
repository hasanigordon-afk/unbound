{
  "name": "DailyFlowEntry",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "flow_date": {
      "type": "string",
      "format": "date"
    },
    "intention": {
      "type": "string"
    },
    "reflection": {
      "type": "string"
    },
    "reflection_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "tasks_completed": {
      "type": "number",
      "default": 0
    },
    "tasks_total": {
      "type": "number",
      "default": 0
    },
    "intention_set": {
      "type": "boolean",
      "default": false
    },
    "reflection_done": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_email",
    "flow_date"
  ]
}