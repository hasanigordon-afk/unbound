{
  "name": "RiseVideoSave",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "video_id": {
      "type": "string"
    },
    "video_title": {
      "type": "string"
    },
    "watched": {
      "type": "boolean",
      "default": false
    },
    "reaction": {
      "type": "string",
      "enum": [
        "hopeful",
        "moved",
        "fired_up",
        "grateful",
        "seen"
      ]
    }
  },
  "required": [
    "user_email",
    "video_id"
  ]
}