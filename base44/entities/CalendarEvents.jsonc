{
  "name": "CalendarEvents",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string",
      "description": "Participant owner email when the event belongs directly to a user"
    },
    "plan_id": {
      "type": "string"
    },
    "roadmap_id": {
      "type": "string",
      "description": "Roadmap.id relationship"
    },
    "title": {
      "type": "string"
    },
    "event_title": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "reminder_time": {
      "type": "string"
    },
    "recurrence": {
      "type": "string"
    },
    "transportation_needed": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "confirmed",
        "completed",
        "missed",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "schedule_text": {
      "type": "string"
    },
    "time_text": {
      "type": "string"
    },
    "needs_review": {
      "type": "boolean",
      "default": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title"
  ]
}