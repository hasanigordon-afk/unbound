{
  "name": "Clients",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "age": {
      "type": "number"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "Linked app user id when the client has an account"
    },
    "participant_email": {
      "type": "string",
      "description": "Canonical participant email used by check-ins, tasks, goals, and support circle records"
    },
    "facility_id": {
      "type": "string",
      "description": "Facility.id relationship"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "discharge_date": {
      "type": "string",
      "format": "date"
    },
    "facility_name": {
      "type": "string"
    },
    "counselor_id": {
      "type": "string"
    },
    "assigned_counselor_email": {
      "type": "string",
      "description": "Counselor user email relationship"
    },
    "housing_status": {
      "type": "string"
    },
    "transportation_status": {
      "type": "string"
    },
    "employment_status": {
      "type": "string"
    },
    "legal_status": {
      "type": "string"
    },
    "veteran_status": {
      "type": "string"
    },
    "primary_recovery_category": {
      "type": "string"
    },
    "substance_type": {
      "type": "string"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "Low",
        "Moderate",
        "High",
        "Urgent"
      ],
      "default": "Moderate"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "full_name"
  ]
}