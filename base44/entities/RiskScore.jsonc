{
  "name": "RiskScore",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "computed_at": {
      "type": "string",
      "format": "date-time"
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "Low",
        "Moderate",
        "High"
      ],
      "default": "Low"
    },
    "contributing_factors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "alert_id": {
      "type": "string"
    },
    "source_version": {
      "type": "string",
      "default": "rezilient-risk-v1"
    }
  },
  "required": [
    "computed_at",
    "risk_score",
    "risk_level"
  ]
}
