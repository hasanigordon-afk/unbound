{
  "name": "NotificationPreference",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Owner email"
    },
    "all_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Master on/off switch"
    },
    "subscribed": {
      "type": "boolean",
      "default": false,
      "description": "User tapped 'Stay Connected' \u2014 subscribed to the 3 H's engagement engine"
    },
    "subscribed_at": {
      "type": "string",
      "format": "date-time"
    },
    "help_enabled": {
      "type": "boolean",
      "default": true,
      "description": "HELP stream \u2014 accountability, check-in nudges, goal tracking"
    },
    "hope_enabled": {
      "type": "boolean",
      "default": true,
      "description": "HOPE stream \u2014 community stories, encouragement, milestones"
    },
    "healing_enabled": {
      "type": "boolean",
      "default": true,
      "description": "HEALING stream \u2014 breathing, meditation, reflection prompts"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "light",
        "balanced",
        "strong"
      ],
      "default": "balanced",
      "description": "How often the user wants to hear from us"
    },
    "focus_preference": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "motivation",
          "stories",
          "reminders",
          "mental_health"
        ]
      },
      "description": "What the user wants more of (from personalization sheet)"
    },
    "daily_motivation": {
      "type": "boolean",
      "default": true
    },
    "recovery_motivation": {
      "type": "boolean",
      "default": true
    },
    "community_updates": {
      "type": "boolean",
      "default": true
    },
    "milestone_reminders": {
      "type": "boolean",
      "default": true
    },
    "app_updates": {
      "type": "boolean",
      "default": true
    },
    "campaign_announcements": {
      "type": "boolean",
      "default": true
    },
    "donation_progress": {
      "type": "boolean",
      "default": false
    },
    "events_partners": {
      "type": "boolean",
      "default": false
    },
    "prompt_status": {
      "type": "string",
      "enum": [
        "not_shown",
        "allowed",
        "dismissed",
        "denied"
      ],
      "default": "not_shown"
    },
    "browser_permission": {
      "type": "string",
      "enum": [
        "default",
        "granted",
        "denied",
        "unsupported"
      ],
      "default": "default"
    },
    "dismissed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_nudge_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time we showed an in-app nudge \u2014 used for frequency throttling"
    },
    "spoken_reminders_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Enable spoken encouragement for milestones and wins"
    },
    "voice_gender": {
      "type": "string",
      "enum": [
        "female",
        "male",
        "system"
      ],
      "default": "female",
      "description": "Preferred voice for spoken reminders"
    },
    "auto_play_milestones": {
      "type": "boolean",
      "default": true,
      "description": "Automatically speak when streak milestones are reached"
    },
    "spoken_goal_celebrations": {
      "type": "boolean",
      "default": true,
      "description": "Speak encouraging words when goals and achievements are completed"
    }
  },
  "required": [
    "user_email"
  ]
}