{
  "name": "AftercareGoals",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "goal_title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "success_measure": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "paused"
      ],
      "default": "active"
    }
  },
  "required": [
    "goal_title"
  ]
}
