{
  "name": "RiseSubmission",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false
    },
    "submission_type": {
      "type": "string",
      "enum": [
        "video",
        "audio",
        "text_with_voice"
      ],
      "default": "video"
    },
    "category": {
      "type": "string",
      "enum": [
        "personal_recovery",
        "redemption_testimony",
        "ahha_moment",
        "motivational_advice",
        "veteran_experience",
        "rebuilding_success"
      ]
    },
    "title": {
      "type": "string"
    },
    "story_text": {
      "type": "string"
    },
    "media_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_review",
        "approved",
        "rejected",
        "flagged"
      ],
      "default": "pending_review"
    },
    "moderation_note": {
      "type": "string"
    },
    "consent_given": {
      "type": "boolean",
      "default": false
    },
    "view_count": {
      "type": "number",
      "default": 0
    },
    "reaction_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_email",
    "submission_type",
    "category",
    "title"
  ]
}