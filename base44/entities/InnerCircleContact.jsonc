{
  "name": "InnerCircleContact",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "sponsor",
        "counselor",
        "trusted_contact",
        "family",
        "other"
      ],
      "default": "trusted_contact"
    },
    "phone": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_email",
    "name",
    "role"
  ]
}