{
  "name": "Meeting",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Meeting name"
    },
    "program_type": {
      "type": "string",
      "enum": [
        "AA",
        "NA",
        "SMART",
        "CA",
        "GA",
        "Other"
      ],
      "description": "Program type"
    },
    "source_name": {
      "type": "string",
      "description": "Meeting feed or import source"
    },
    "meeting_type": {
      "type": "string",
      "enum": [
        "AA",
        "NA",
        "SMART",
        "CelebrateRecovery",
        "Other"
      ],
      "description": "Canonical meeting type"
    },
    "meeting_format": {
      "type": "string",
      "enum": [
        "open",
        "closed",
        "hybrid",
        "unspecified"
      ],
      "default": "unspecified",
      "description": "Open (anyone can attend), closed (members only), or hybrid"
    },
    "format": {
      "type": "string",
      "description": "Human-readable format from source feed"
    },
    "in_person": {
      "type": "boolean",
      "default": true,
      "description": "Is this an in-person meeting?"
    },
    "address": {
      "type": "string",
      "description": "Street address"
    },
    "city": {
      "type": "string",
      "description": "City"
    },
    "state": {
      "type": "string",
      "description": "State"
    },
    "zip": {
      "type": "string",
      "description": "ZIP code"
    },
    "latitude": {
      "type": "number",
      "description": "Latitude"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude"
    },
    "day_of_week": {
      "type": "number",
      "description": "0=Sunday, 6=Saturday"
    },
    "start_time": {
      "type": "string",
      "description": "Start time (HH:MM, 24h)"
    },
    "end_time": {
      "type": "string",
      "description": "End time (HH:MM, 24h)"
    },
    "timezone": {
      "type": "string",
      "description": "Meeting timezone"
    },
    "url": {
      "type": "string",
      "description": "Online meeting URL"
    },
    "online_url": {
      "type": "string",
      "description": "Online meeting URL alias"
    },
    "phone": {
      "type": "string",
      "description": "Phone access or contact"
    },
    "accessibility_notes": {
      "type": "string",
      "description": "Accessibility notes when supplied by source"
    },
    "language": {
      "type": "string",
      "description": "Meeting language"
    },
    "source_url": {
      "type": "string",
      "description": "Source feed URL"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last sync timestamp"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Meeting is active"
    }
  },
  "required": [
    "title",
    "program_type",
    "city",
    "state"
  ]
}