{
  "name": "TopFiveNonNegotiable",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Owner email"
    },
    "title": {
      "type": "string",
      "description": "The non-negotiable life mission objective"
    },
    "why_it_matters": {
      "type": "string",
      "description": "Emotional reason this goal matters"
    },
    "personal_quote": {
      "type": "string",
      "description": "Personal quote or reminder attached to this goal"
    },
    "image_url": {
      "type": "string",
      "description": "Pinned motivational image URL"
    },
    "voice_reminder_url": {
      "type": "string",
      "description": "Uploaded voice reminder audio URL"
    },
    "progress": {
      "type": "number",
      "default": 0,
      "description": "Milestone progress percentage from 0 to 100"
    },
    "months_complete": {
      "type": "number",
      "default": 0,
      "description": "Number of months completed toward the mission"
    },
    "duration_months": {
      "type": "number",
      "default": 12,
      "description": "Total mission duration in months"
    },
    "daily_focus_level": {
      "type": "string",
      "enum": [
        "struggling",
        "focused",
        "locked_in"
      ],
      "default": "focused",
      "description": "Current daily focus level"
    },
    "current_streak": {
      "type": "number",
      "default": 0,
      "description": "Current daily streak count"
    },
    "priority_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "description": "Mission priority level"
    },
    "last_checkin_date": {
      "type": "string",
      "format": "date",
      "description": "Last mission check-in date"
    },
    "sort_order": {
      "type": "number",
      "default": 1,
      "description": "Display order from 1 to 5"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_email",
    "title",
    "sort_order"
  ]
}