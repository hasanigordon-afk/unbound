{
  "name": "VeteranResource",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "va_hospital",
        "mental_health",
        "substance_abuse",
        "housing",
        "employment",
        "jobs",
        "food_emergency",
        "food",
        "legal",
        "crisis",
        "fitness"
      ]
    },
    "subcategory": {
      "type": "string",
      "description": "Free-text sub-classification (e.g. 'VA Medical Center', 'Peer Support Helpline')"
    },
    "description": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "county": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "eligibility": {
      "type": "string",
      "description": "Who can access this resource (free text or veterans/general/both)"
    },
    "hours": {
      "type": "string",
      "description": "Operating hours, e.g. 'Mon\u2013Fri 8am\u20135pm'"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "priority_score": {
      "type": "number",
      "default": 0,
      "description": "Higher = surfaces first in listings"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Mark as featured resource"
    },
    "search_keywords": {
      "type": "string",
      "description": "Additional searchable terms, comma-separated"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Veteran Verified tag"
    }
  },
  "required": [
    "name",
    "category"
  ]
}