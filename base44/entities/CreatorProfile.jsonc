{
  "name": "CreatorProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "talent_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "personal_story": {
      "type": "string"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "has_facility_endorsement": {
      "type": "boolean",
      "default": false
    },
    "rating_avg": {
      "type": "number",
      "default": 0
    },
    "review_count": {
      "type": "number",
      "default": 0
    },
    "follower_count": {
      "type": "number",
      "default": 0
    },
    "completed_orders": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "Seed/demo content \u2014 safe to hide or delete"
    }
  },
  "required": [
    "user_email",
    "display_name"
  ]
}