{
  "name": "UniversalResource",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "category": { "type": "string" },
    "subcategory": { "type": "string" },
    "description": { "type": "string" },
    "address": { "type": "string" },
    "city": { "type": "string" },
    "state": { "type": "string" },
    "zip": { "type": "string" },
    "county": { "type": "string" },
    "latitude": { "type": "number" },
    "longitude": { "type": "number" },
    "phone": { "type": "string" },
    "email": { "type": "string" },
    "website": { "type": "string" },
    "source_name": { "type": "string" },
    "source_url": { "type": "string" },
    "source_type": {
      "type": "string",
      "enum": ["api", "csv", "manual", "admin", "partner"],
      "default": "manual"
    },
    "verification_status": {
      "type": "string",
      "enum": ["verified", "needs_review", "user_submitted", "imported", "inactive"],
      "default": "needs_review"
    },
    "last_verified_at": { "type": "string", "format": "date-time" },
    "last_synced_at": { "type": "string", "format": "date-time" },
    "hours_json": { "type": "object" },
    "accepts_medicaid": { "type": "boolean", "default": false },
    "accepts_medicare": { "type": "boolean", "default": false },
    "accepts_private_insurance": { "type": "boolean", "default": false },
    "free_or_low_cost": { "type": "boolean", "default": false },
    "faith_based": { "type": "boolean", "default": false },
    "veteran_focused": { "type": "boolean", "default": false },
    "reentry_focused": { "type": "boolean", "default": false },
    "women_only": { "type": "boolean", "default": false },
    "men_only": { "type": "boolean", "default": false },
    "youth_focused": { "type": "boolean", "default": false },
    "wheelchair_accessible": { "type": "boolean", "default": false },
    "virtual_available": { "type": "boolean", "default": false },
    "languages": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "eligibility_notes": { "type": "string" },
    "intake_notes": { "type": "string" },
    "documents_required": { "type": "string" },
    "transportation_options": { "type": "string" },
    "emergency_available": { "type": "boolean", "default": false },
    "crisis_available": { "type": "boolean", "default": false },
    "rating_score": { "type": "number" },
    "user_saved_count": { "type": "number", "default": 0 }
  },
  "required": ["name", "category", "source_name", "source_type", "verification_status"]
}
