{
  "name": "DailyTasks",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string",
      "description": "Participant owner email when the task belongs directly to a user"
    },
    "plan_id": {
      "type": "string"
    },
    "roadmap_id": {
      "type": "string",
      "description": "Roadmap.id relationship"
    },
    "task_title": {
      "type": "string"
    },
    "task_category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "due_time": {
      "type": "string"
    },
    "recurrence": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "task_title"
  ]
}